# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
.env
*.env
!.env.example

# GaniParser (Ganit's own document-parsing product) — reference copy only.
# NOT vendored into this repo: it is ~39MB, ships real customer invoices/PDFs as
# test fixtures, and several legacy Streamlit modules hardcode live AWS keys in
# .py source (which the .env rules above do NOT cover). The integration in
# backend/services/gani_*.py reimplements the logic against backend/config.py
# credentials instead of importing any of it.
Gani_Parser_Latest/

# ── Python ────────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# ── Generated data (rebuilt locally) ──────────────────────────────────────────
data/vectorstore/
data/price_cache.json
data/token_usage.csv

# ── Runtime claim data (created by the app, never committed) ──────────────────
data/claims/
data/reports/

# ── Demo media supplied at demo time ──────────────────────────────────────────
# The generated showcase fixtures (PDFs, telematics JSON, *_NEEDED.txt, README)
# are committed; the real photos / dashcam clips dropped into test/ are not.
test/**/*.jpg
test/**/*.jpeg
test/**/*.png
test/**/*.webp
test/**/*.mp4
test/**/*.mov
test/**/*.avi

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.DS_Store
Thumbs.db
*.suo
*.sw?

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
