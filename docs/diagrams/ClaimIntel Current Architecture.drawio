<mxCell id="leg_e3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9E9E9E;strokeWidth=1.4;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="leg_a3" target="leg_b3"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="1570" as="sourcePoint"/><mxPoint x="1030" y="1570" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="title" value="&lt;b&gt;CLAIMINTEL — Current Architecture (as built)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=26;align=center;verticalAlign=middle;fontColor=#0D1B2A;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1780" height="40" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Runs on one machine (laptop or Docker Compose) · no database server · no cloud hosting · verified against the code, 2026-09-14" style="text;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fontColor=#37474F;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1780" height="26" as="geometry"/></mxCell>
<mxCell id="OF_t" value="&lt;b&gt;4. INVESTIGATION ORCHESTRATOR&lt;/b&gt; (Python asyncio) — gate → evidence → agents → guards · every step streamed to the UI" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#1B5E20;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="342" y="264" width="800" height="26" as="geometry"/></mxCell>
<mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;Customer — files a claim&lt;br&gt;Adjudicator — investigates &amp;amp; decides" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="react" value="&lt;b&gt;React 19 + Vite web app&lt;/b&gt;&lt;br&gt;New Claim · Claims Queue · Claim Dashboard&lt;br&gt;Fraud Queue · Analytics" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;FastAPI backend (REST API)&lt;/b&gt;&lt;br&gt;runs each investigation as a background task" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#37474F;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="332" height="80" as="geometry"/></mxCell>
<mxCell id="t_rest" value="REST calls · role sent as X-Role header" style="text;html=1;whiteSpace=wrap;fontSize=10;align=center;verticalAlign=middle;fontColor=#37474F;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="745" y="143" width="250" height="20" as="geometry"/></mxCell>
<mxCell id="t_sse" value="live agent progress (Server-Sent Events)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=center;verticalAlign=middle;fontColor=#37474F;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="745" y="202" width="250" height="18" as="geometry"/></mxCell>
<mxCell id="t_login" value="&lt;i&gt;Demo login, no identity provider · investigate, decide &amp;amp; fraud queue are adjudicator-only&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#37474F;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="360" y="228" width="640" height="22" as="geometry"/></mxCell>
<mxCell id="t_post" value="POST /investigate" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#37474F;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1168" y="228" width="150" height="22" as="geometry"/></mxCell>
<mxCell id="CF" value="&lt;b&gt;1. CLAIM FILING&lt;/b&gt;&lt;br&gt;&lt;i&gt;customer, via the web app&lt;/i&gt;&lt;br&gt;&lt;br&gt;Phone lookup → policy&lt;br&gt;&lt;br&gt;Upload photos, garage estimate, FIR, DL, RC, telematics (JSON/CSV), dash-cam MP4&lt;br&gt;&lt;br&gt;Optional: auto-fill the form from a scanned claim form (same document pipeline)&lt;br&gt;&lt;br&gt;Saved to claims.csv + data/claims/{id}/" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="310" as="geometry"/></mxCell>
<mxCell id="t_trigger" value="Adjudicator clicks &lt;b&gt;Investigate&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=center;verticalAlign=middle;fontColor=#E65100;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="243" y="384" width="84" height="62" as="geometry"/></mxCell>
<mxCell id="G0" value="&lt;b&gt;2. G0 ELIGIBILITY GATE&lt;/b&gt;&lt;br&gt;Python only · &lt;b&gt;NO AI call&lt;/b&gt;&lt;br&gt;runs before any document is read&lt;br&gt;&lt;br&gt;13 metadata fraud checks&lt;br&gt;Policy in force on incident date&lt;br&gt;Scope of cover (e.g. TP-only policy vs own-damage claim)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="180" height="220" as="geometry"/></mxCell>
<mxCell id="G0R" value="&lt;b&gt;REJECT at the gate&lt;/b&gt;&lt;br&gt;all agents skipped&lt;br&gt;zero AI cost" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="360" y="640" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="t_noteli" value="not eligible" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=middle;fontColor=#C62828;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="456" y="596" width="90" height="22" as="geometry"/></mxCell>
<mxCell id="t_eli" value="eligible" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=middle;fontColor=#37474F;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="541" y="448" width="40" height="20" as="geometry"/></mxCell>
<mxCell id="ea" value="&lt;b&gt;a) Document text&lt;/b&gt;&lt;br&gt;Digital PDF → its own text layer&lt;br&gt;Scan / photo → Amazon Textract" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="595" y="400" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="eb" value="&lt;b&gt;b) Field extraction&lt;/b&gt;&lt;br&gt;Groq text LLM&lt;br&gt;estimate · FIR · DL · RC" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="595" y="478" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="ec" value="&lt;b&gt;c) Document forgery check&lt;/b&gt;&lt;br&gt;Bedrock vision on the document image" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="595" y="556" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="ed" value="&lt;b&gt;d) PII masking&lt;/b&gt;&lt;br&gt;names &amp;amp; phone masked in AI prompts, UI, PDFs, disk" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="595" y="634" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="ee" value="&lt;b&gt;e) Dash-cam&lt;/b&gt;&lt;br&gt;OpenCV → 4 frames → local AI-image detector (ONNX)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="595" y="712" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="ef" value="&lt;b&gt;f) Telematics parser&lt;/b&gt;&lt;br&gt;JSON or CSV → GPS trail, speed, braking, impact" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="595" y="790" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="A1" value="&lt;b&gt;A1 Damage Assessment&lt;/b&gt; — Bedrock Qwen3-VL&lt;br&gt;Photos vs garage-estimate line items · damage boxes&lt;br&gt;EXIF + local AI-image checks · cached replay if evidence unchanged" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="942" y="400" width="390" height="95" as="geometry"/></mxCell>
<mxCell id="A3" value="&lt;b&gt;A3 Incident Reconstruction&lt;/b&gt;&lt;br&gt;Bedrock Qwen3-VL&lt;br&gt;&lt;br&gt;Photos + dash-cam frames vs the claimant's story · cached replay" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="942" y="535" width="190" height="130" as="geometry"/></mxCell>
<mxCell id="A2" value="&lt;b&gt;A2 Fraud Intelligence&lt;/b&gt;&lt;br&gt;Groq gpt-oss-120b&lt;br&gt;&lt;br&gt;32 fraud checks in Python · score computed in code, AI adjusts ±15 · fraud archive + telematics GPS" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1142" y="535" width="190" height="130" as="geometry"/></mxCell>
<mxCell id="A4" value="&lt;b&gt;A4 Context Verification&lt;/b&gt; — Groq&lt;br&gt;Geocode incident location · telematics GPS match · weather at incident time" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="942" y="700" width="390" height="70" as="geometry"/></mxCell>
<mxCell id="A5" value="&lt;b&gt;A5 Settlement Recommendation&lt;/b&gt; — Groq&lt;br&gt;Reads all findings + knowledge base · writes the rationale" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="942" y="800" width="390" height="65" as="geometry"/></mxCell>
<mxCell id="t_par" value="&lt;i&gt;then in parallel&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=center;verticalAlign=middle;fontColor=#4527A0;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="948" y="499" width="88" height="32" as="geometry"/></mxCell>
<mxCell id="pr" value="&lt;b&gt;Parts pricing&lt;/b&gt;&lt;br&gt;OEM price catalogue (≤ 90 days) → live web price → 'unpriced', never invented" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="375" y="948" width="152" height="112" as="geometry"/></mxCell>
<mxCell id="lab" value="&lt;b&gt;Labour engine&lt;/b&gt;&lt;br&gt;rule-based, per operation&lt;br&gt;feeds parts pricing · read by A2 as evidence only" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="542" y="948" width="152" height="112" as="geometry"/></mxCell>
<mxCell id="irdai" value="&lt;b&gt;IRDAI rules&lt;/b&gt;&lt;br&gt;versioned JSON · range-checked · hash stamped on every result" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="709" y="948" width="152" height="112" as="geometry"/></mxCell>
<mxCell id="calc" value="&lt;b&gt;Settlement calculator&lt;/b&gt;&lt;br&gt;Net = Approved basis − Depreciation − Deductibles&lt;br&gt;inflation cap before total-loss test" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="876" y="948" width="152" height="112" as="geometry"/></mxCell>
<mxCell id="HG" value="&lt;b&gt;7. HARD GUARDS + FINAL DECISION&lt;/b&gt;&lt;br&gt;&lt;i&gt;Python — overrides the AI&lt;/i&gt;&lt;br&gt;• Policy expired → Reject&lt;br&gt;• Fraud score ≥ 70 → Reject · 40–69 → Escalate&lt;br&gt;• Damage doesn't match story → Escalate&lt;br&gt;• Garage quote &amp;gt; 40% over fair value → Escalate&lt;br&gt;• Low confidence / failed photo check → Pending Review&lt;br&gt;• Any agent error → no auto-approve" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1072" y="920" width="260" height="175" as="geometry"/></mxCell>
<mxCell id="t_pay" value="payout" style="text;html=1;whiteSpace=wrap;fontSize=9;align=center;verticalAlign=middle;fontColor=#37474F;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1029" y="978" width="42" height="24" as="geometry"/></mxCell>
<mxCell id="r_app" value="&lt;b&gt;APPROVE&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="390" y="1185" width="230" height="32" as="geometry"/></mxCell>
<mxCell id="r_esc" value="&lt;b&gt;ESCALATE&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="390" y="1222" width="230" height="32" as="geometry"/></mxCell>
<mxCell id="r_pen" value="&lt;b&gt;PENDING REVIEW&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="390" y="1259" width="230" height="32" as="geometry"/></mxCell>
<mxCell id="r_rej" value="&lt;b&gt;REJECT&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="390" y="1296" width="230" height="32" as="geometry"/></mxCell>
<mxCell id="AR" value="&lt;b&gt;9. ADJUDICATOR REVIEW&lt;/b&gt;&lt;br&gt;&lt;i&gt;human — not an agent&lt;/i&gt;&lt;br&gt;Reviews the evidence on the dashboard&lt;br&gt;Records decision &amp;amp; notes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="690" y="1175" width="260" height="115" as="geometry"/></mxCell>
<mxCell id="OU" value="&lt;b&gt;10. OUTPUTS&lt;/b&gt;&lt;br&gt;• PDF investigation report (fpdf2)&lt;br&gt;• Customer decision letter (PDF)&lt;br&gt;• Claim status in the queue + full result.json&lt;br&gt;• Analytics: Claims · Solution Performance · FinOps (AI cost)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=middle;spacing=6;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="1010" y="1150" width="340" height="180" as="geometry"/></mxCell>
