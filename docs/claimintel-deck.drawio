        <mxCell id="c85" value="&lt;b&gt;What sits behind the agents&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=52;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="36" width="1800" height="74" as="geometry"/></mxCell>
        <mxCell id="c86" value="Five layers &amp;#8212; orchestration in the middle, evidence in, decision out" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontColor=#64748B;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="60" y="104" width="1800" height="36" as="geometry"/></mxCell>
        <mxCell id="c87" value="" style="line;strokeWidth=3;html=1;strokeColor=#E2E8F0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="1800" height="10" as="geometry"/></mxCell>
        <mxCell id="c88" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF9FD;strokeColor=#0891B2;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="206" width="336" height="430" as="geometry"/></mxCell>
        <mxCell id="c89" value="KNOWLEDGE BASE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0891B2;strokeColor=none;fontColor=#FFFFFF;fontSize=25;fontStyle=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="63" y="209" width="330" height="68" as="geometry"/></mxCell>
        <mxCell id="c90" value="&amp;#8226;&amp;nbsp;&amp;nbsp;Vector search over policy wordings&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Fraud indicators and schemes&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Archive of confirmed fraud cases&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Runs locally, no API key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="84" y="298" width="288" height="322" as="geometry"/></mxCell>
        <mxCell id="c91" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FAF3;strokeColor=#15803D;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="426" y="206" width="336" height="430" as="geometry"/></mxCell>
        <mxCell id="c92" value="DETERMINISTIC ENGINES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=none;fontColor=#FFFFFF;fontSize=25;fontStyle=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="429" y="209" width="330" height="68" as="geometry"/></mxCell>
        <mxCell id="c93" value="&amp;#8226;&amp;nbsp;&amp;nbsp;Eligibility and cover rules&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Pricing and labour&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Settlement calculator&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;IRDAI rules, version-stamped" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="450" y="298" width="288" height="322" as="geometry"/></mxCell>
        <mxCell id="c94" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F9F5FF;strokeColor=#7C3AED;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="792" y="206" width="336" height="430" as="geometry"/></mxCell>
        <mxCell id="c95" value="ORCHESTRATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=none;fontColor=#FFFFFF;fontSize=25;fontStyle=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="795" y="209" width="330" height="68" as="geometry"/></mxCell>
        <mxCell id="c96" value="&amp;#8226;&amp;nbsp;&amp;nbsp;Runs the agents, streams progress&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Writes a result after each one&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Applies the guards last&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;A failure never hangs the UI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="816" y="298" width="288" height="322" as="geometry"/></mxCell>
        <mxCell id="c97" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F5FF;strokeColor=#4F46E5;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="1158" y="206" width="336" height="430" as="geometry"/></mxCell>
        <mxCell id="c98" value="AGENTS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=none;fontColor=#FFFFFF;fontSize=25;fontStyle=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1161" y="209" width="330" height="68" as="geometry"/></mxCell>
        <mxCell id="c99" value="&amp;#8226;&amp;nbsp;&amp;nbsp;Six agents, two with no model&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Vision for photos and documents&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Text for fraud and settlement&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Repeat runs replay identically" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1182" y="298" width="288" height="322" as="geometry"/></mxCell>
        <mxCell id="c100" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFFAF9;strokeColor=#0D9488;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="1524" y="206" width="336" height="430" as="geometry"/></mxCell>
        <mxCell id="c101" value="STATE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=none;fontColor=#FFFFFF;fontSize=25;fontStyle=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1527" y="209" width="330" height="68" as="geometry"/></mxCell>
        <mxCell id="c102" value="&amp;#8226;&amp;nbsp;&amp;nbsp;No database &amp;#8212; files on disk&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Claimant name and phone encrypted&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Full audit trail per claim&lt;br&gt;&amp;#8226;&amp;nbsp;&amp;nbsp;Token and cost ledger" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1548" y="298" width="288" height="322" as="geometry"/></mxCell>
        <mxCell id="c103" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#B45309;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="1800" height="320" as="geometry"/></mxCell>
        <mxCell id="c104" value="MODEL LAYER  &amp;#8212;  all inference in AWS ap-south-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="63" y="679" width="1794" height="70" as="geometry"/></mxCell>
        <mxCell id="c105" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="90" y="770" width="414" height="118" as="geometry"/></mxCell>
        <mxCell id="c106" value="&lt;b&gt;TEXT&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#B45309&#x27;&gt;openai.gpt-oss-120b&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:21px&#x27; color=&#x27;#94A3B8&#x27;&gt;fraud, settlement, documents&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="100" y="776" width="394" height="106" as="geometry"/></mxCell>
        <mxCell id="c107" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="533" y="770" width="414" height="118" as="geometry"/></mxCell>
        <mxCell id="c108" value="&lt;b&gt;VISION&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#B45309&#x27;&gt;qwen3-vl-235b&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:21px&#x27; color=&#x27;#94A3B8&#x27;&gt;damage photos, authenticity&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="543" y="776" width="394" height="106" as="geometry"/></mxCell>
        <mxCell id="c109" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="976" y="770" width="414" height="118" as="geometry"/></mxCell>
        <mxCell id="c110" value="&lt;b&gt;EMBEDDINGS&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#B45309&#x27;&gt;runs locally&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:21px&#x27; color=&#x27;#94A3B8&#x27;&gt;no API, no key, works offline&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="986" y="776" width="394" height="106" as="geometry"/></mxCell>
        <mxCell id="c111" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1419" y="770" width="414" height="118" as="geometry"/></mxCell>
        <mxCell id="c112" value="&lt;b&gt;FALLBACK&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#B45309&#x27;&gt;Groq, US-hosted&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:21px&#x27; color=&#x27;#94A3B8&#x27;&gt;permanent errors only&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=25;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1429" y="776" width="394" height="106" as="geometry"/></mxCell>
        <mxCell id="c113" value="Every model call is made inside India. The Groq fallback is reached only when a model ID goes permanently bad &amp;#8212;&lt;br&gt;never on a throttle, because silently retrying abroad would defeat the residency this layer exists to hold." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=23;fontColor=#78350F;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="90" y="906" width="1740" height="74" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
