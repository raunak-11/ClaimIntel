        <mxCell id="c67" value="32 weighted checks. Python owns the score; the model may only nudge it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=26;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1320" y="326" width="510" height="150" as="geometry"/></mxCell>
        <mxCell id="c68" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F5FF;strokeColor=#4F46E5;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="570" height="292" as="geometry"/></mxCell>
        <mxCell id="c69" value="A3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=none;fontColor=#FFFFFF;fontSize=26;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="86" y="576" width="58" height="58" as="geometry"/></mxCell>
        <mxCell id="c70" value="&lt;b&gt;Incident Reconstruction&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=29;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="160" y="576" width="444" height="42" as="geometry"/></mxCell>
        <mxCell id="c71" value="vision" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#64748B;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="160" y="618" width="444" height="28" as="geometry"/></mxCell>
        <mxCell id="c72" value="Rebuilds the crash from photos and dash-cam. Does the story match?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=26;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="90" y="670" width="510" height="150" as="geometry"/></mxCell>
        <mxCell id="c73" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FAF3;strokeColor=#15803D;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="675" y="550" width="570" height="292" as="geometry"/></mxCell>
        <mxCell id="c74" value="A4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=none;fontColor=#FFFFFF;fontSize=26;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="701" y="576" width="58" height="58" as="geometry"/></mxCell>
        <mxCell id="c75" value="&lt;b&gt;Context Verification&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=29;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="775" y="576" width="444" height="42" as="geometry"/></mxCell>
        <mxCell id="c76" value="no model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#15803D;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="775" y="618" width="444" height="28" as="geometry"/></mxCell>
        <mxCell id="c77" value="Geocoding, GPS and weather. Pure APIs and arithmetic &amp;#8212; no AI at all." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=26;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="705" y="670" width="510" height="150" as="geometry"/></mxCell>
        <mxCell id="c78" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F5F5FF;strokeColor=#4F46E5;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="1290" y="550" width="570" height="292" as="geometry"/></mxCell>
        <mxCell id="c79" value="A5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=none;fontColor=#FFFFFF;fontSize=26;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1316" y="576" width="58" height="58" as="geometry"/></mxCell>
        <mxCell id="c80" value="&lt;b&gt;Settlement Recommendation&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=29;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1390" y="576" width="444" height="42" as="geometry"/></mxCell>
        <mxCell id="c81" value="text" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#64748B;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1390" y="618" width="444" height="28" as="geometry"/></mxCell>
        <mxCell id="c82" value="Explains the outcome. Every rupee comes from the calculator, not the model." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=26;fontColor=#0F172A;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1320" y="670" width="510" height="150" as="geometry"/></mxCell>
        <mxCell id="c83" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=3;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="884" width="1800" height="112" as="geometry"/></mxCell>
        <mxCell id="c84" value="&lt;b&gt;Two of the six make no model call at all.&lt;/b&gt; Every figure that touches money &amp;#8212; prices, labour, depreciation, the payout &amp;#8212; is computed by versioned Python that can be tested and replayed." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontColor=#334155;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="90" y="896" width="1740" height="88" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 - Architecture" id="page-2">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
