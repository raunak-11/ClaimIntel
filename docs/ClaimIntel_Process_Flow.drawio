        <mxCell id="c12" value="&lt;ul style=&#x27;margin:0;padding-left:16px;text-align:left;font-size:12px;line-height:1.35;color:#3C4A63&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Phone lookup pulls the &lt;b&gt;policy on record&lt;/b&gt;&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Claim form auto-fills from the DL / RC photo&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Evidence in: damage photos, FIR, garage estimate, DL, RC, telematics CSV, dash-cam&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Claim ID issued &amp;#8212; never reused&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#3C4A63;fontFamily=Helvetica;spacingLeft=2;spacingTop=0;movable=0;resizable=0;" vertex="1" parent="c10">
