        </mxCell>
        <mxCell id="c17" value="&lt;ul style=&#x27;margin:0;padding-left:16px;text-align:left;font-size:12px;line-height:1.35;color:#3C4A63&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;&lt;b&gt;Deterministic &amp;#8212; no model call&lt;/b&gt;&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;13 metadata checks on the claim record&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Was the policy &lt;b&gt;in force&lt;/b&gt; on the incident date?&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Does the &lt;b&gt;cover&lt;/b&gt; extend to this loss? A third-party-only policy cannot file own damage&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#3C4A63;fontFamily=Helvetica;spacingLeft=2;spacingTop=0;movable=0;resizable=0;" vertex="1" parent="c15">
          <mxGeometry x="10" y="42" width="350" height="276" as="geometry"/>
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;HARD STOP&lt;/b&gt; &amp;#8212; a rejection here costs zero model calls, and the letter cites the actual reason." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCF3F4;strokeColor=#B4283C;dashed=1;dashPattern=4 3;align=left;verticalAlign=middle;fontSize=11;fontColor=#B4283C;fontFamily=Helvetica;spacingLeft=6;spacingRight=6;movable=0;" vertex="1" parent="c15">
          <mxGeometry x="10" y="314" width="350" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="c19" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2DAE7;strokeWidth=1;verticalAlign=top;align=left;container=1;collapsible=0;childLayout=none;movable=1;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="852" y="162" width="370" height="372" as="geometry"/>
        </mxCell>
        <mxCell id="c20" value="3  EVIDENCE PARSING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F7A73;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;movable=0;resizable=0;deletable=1;" vertex="1" parent="c19">
          <mxGeometry x="0" y="0" width="370" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="&lt;ul style=&#x27;margin:0;padding-left:16px;text-align:left;font-size:12px;line-height:1.35;color:#3C4A63&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Born-digital PDF reads &lt;b&gt;its own text layer&lt;/b&gt; &amp;#8212; free, exact, stays on the machine&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Scans go to OCR; line structure is the contract&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Model extraction, then an authenticity read&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Telematics GPS and dash-cam frames decoded&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;&lt;b&gt;PII masked at every egress&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#3C4A63;fontFamily=Helvetica;spacingLeft=2;spacingTop=0;movable=0;resizable=0;" vertex="1" parent="c19">
          <mxGeometry x="10" y="42" width="350" height="304" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="" style="line;strokeWidth=1;html=1;strokeColor=#D2DAE7;movable=0;resizable=0;" vertex="1" parent="c19">
          <mxGeometry x="0" y="346" width="370" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="c23" value="&amp;#8594; shared claim context" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#6B7891;fontFamily=Helvetica;spacingLeft=12;movable=0;resizable=0;" vertex="1" parent="c19">
          <mxGeometry x="0" y="346" width="370" height="26" as="geometry"/>
