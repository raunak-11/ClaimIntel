        <mxCell id="c24" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2DAE7;strokeWidth=1;verticalAlign=top;align=left;container=1;collapsible=0;childLayout=none;movable=1;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1258" y="162" width="370" height="372" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="4  CONTEXT CHECKPOINT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4B3FA3;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;movable=0;resizable=0;deletable=1;" vertex="1" parent="c24">
          <mxGeometry x="0" y="0" width="370" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="&lt;ul style=&#x27;margin:0;padding-left:16px;text-align:left;font-size:12px;line-height:1.35;color:#3C4A63&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Parsed docs, policy and claim assembled &lt;b&gt;once&lt;/b&gt;&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;All five agents read the same context&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;The damage read is keyed on a hash of image bytes + estimate line items + claim fields&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;&lt;b&gt;Identical evidence replays&lt;/b&gt;; a changed photo re-reads&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#3C4A63;fontFamily=Helvetica;spacingLeft=2;spacingTop=0;movable=0;resizable=0;" vertex="1" parent="c24">
          <mxGeometry x="10" y="42" width="350" height="304" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="" style="line;strokeWidth=1;html=1;strokeColor=#D2DAE7;movable=0;resizable=0;" vertex="1" parent="c24">
          <mxGeometry x="0" y="346" width="370" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="c28" value="no re-parsing &amp;#183; no re-billing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#6B7891;fontFamily=Helvetica;spacingLeft=12;movable=0;resizable=0;" vertex="1" parent="c24">
          <mxGeometry x="0" y="346" width="370" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2DAE7;strokeWidth=1;verticalAlign=top;align=left;container=1;collapsible=0;childLayout=none;movable=1;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="1664" y="162" width="370" height="372" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="5  INVESTIGATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2A4D93;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;movable=0;resizable=0;deletable=1;" vertex="1" parent="c29">
          <mxGeometry x="0" y="0" width="370" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="&lt;ul style=&#x27;margin:0;padding-left:16px;text-align:left;font-size:12px;line-height:1.35;color:#3C4A63&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;A1&amp;#8211;A5 run async over the shared context&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Each agent&#x27;s verdict streams to the adjudicator as it lands&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;The claim record is written after every agent, not at the end&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;An errored agent &lt;b&gt;blocks approval&lt;/b&gt; &amp;#8212; it never quietly scores zero&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#3C4A63;fontFamily=Helvetica;spacingLeft=2;spacingTop=0;movable=0;resizable=0;" vertex="1" parent="c29">
          <mxGeometry x="10" y="42" width="350" height="304" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="" style="line;strokeWidth=1;html=1;strokeColor=#D2DAE7;movable=0;resizable=0;" vertex="1" parent="c29">
          <mxGeometry x="0" y="346" width="370" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="reload mid-run and rejoin the live pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#6B7891;fontFamily=Helvetica;spacingLeft=12;movable=0;resizable=0;" vertex="1" parent="c29">
          <mxGeometry x="0" y="346" width="370" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2DAE7;strokeWidth=1;verticalAlign=top;align=left;container=1;collapsible=0;childLayout=none;movable=1;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="2070" y="162" width="370" height="372" as="geometry"/>
        </mxCell>
        <mxCell id="c35" value="6  MONEY MATHS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5FA9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;movable=0;resizable=0;deletable=1;" vertex="1" parent="c34">
          <mxGeometry x="0" y="0" width="370" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c36" value="&lt;ul style=&#x27;margin:0;padding-left:16px;text-align:left;font-size:12px;line-height:1.35;color:#3C4A63&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Fraud score = &lt;b&gt;sum of check weights&lt;/b&gt;; the model may move it &amp;#177;15, never past the band&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Parts priced OEM catalogue &amp;#8594; live web &amp;#8594; unpriced. An unpriced part is reported, not invented&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Labour per operation from config&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Net = Basis &amp;#8722; Depreciation &amp;#8722; Deductibles&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#3C4A63;fontFamily=Helvetica;spacingLeft=2;spacingTop=0;movable=0;resizable=0;" vertex="1" parent="c34">
          <mxGeometry x="10" y="42" width="350" height="304" as="geometry"/>
        </mxCell>
        <mxCell id="c37" value="" style="line;strokeWidth=1;html=1;strokeColor=#D2DAE7;movable=0;resizable=0;" vertex="1" parent="c34">
          <mxGeometry x="0" y="346" width="370" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="c38" value="Python-authoritative &amp;#183; no LLM" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#6B7891;fontFamily=Helvetica;spacingLeft=12;movable=0;resizable=0;" vertex="1" parent="c34">
          <mxGeometry x="0" y="346" width="370" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="c39" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2DAE7;strokeWidth=1;verticalAlign=top;align=left;container=1;collapsible=0;childLayout=none;movable=1;resizable=1;" vertex="1" parent="1">
          <mxGeometry x="2476" y="162" width="370" height="372" as="geometry"/>
        </mxCell>
        <mxCell id="c40" value="7  GUARDS &amp;amp; DECISION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B4283C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;movable=0;resizable=0;deletable=1;" vertex="1" parent="c39">
          <mxGeometry x="0" y="0" width="370" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="c41" value="&lt;ul style=&#x27;margin:0;padding-left:16px;text-align:left;font-size:12px;line-height:1.35;color:#3C4A63&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;&lt;b&gt;Hard guards override the model&lt;/b&gt;&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Fraud &amp;#8805; 70 &amp;#8594; Reject &amp;#183; 40&amp;#8211;69 &amp;#8594; Escalate&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Damage that contradicts the story &amp;#8594; Escalate&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Quote &amp;gt; 40% over fair value &amp;#8594; capped, the excess booked as prevented leakage&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;&lt;b&gt;The cap runs before the total-loss test&lt;/b&gt;, so an inflated write-off collapses on its own arithmetic&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#3C4A63;fontFamily=Helvetica;spacingLeft=2;spacingTop=0;movable=0;resizable=0;" vertex="1" parent="c39">
          <mxGeometry x="10" y="42" width="350" height="304" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="" style="line;strokeWidth=1;html=1;strokeColor=#D2DAE7;movable=0;resizable=0;" vertex="1" parent="c39">
          <mxGeometry x="0" y="346" width="370" height="1" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="fails closed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#6B7891;fontFamily=Helvetica;spacingLeft=12;movable=0;resizable=0;" vertex="1" parent="c39">
