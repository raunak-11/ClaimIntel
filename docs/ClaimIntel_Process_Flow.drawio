        <mxCell id="c11" value="1  INTAKE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5FA9;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Helvetica;movable=0;resizable=0;deletable=1;" vertex="1" parent="c10">
