        <mxCell id="n1" value="ClaimIntel &amp;#183; Backend Agentic Process Flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#10264F;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="Every box is a real backend function or module. Blue is an AI agent, orange is a human decision, white is deterministic Python, red-edged is a guard that overrides the model." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4B6793;" vertex="1" parent="1"><mxGeometry x="40" y="38" width="1400" height="20" as="geometry"/></mxCell>
        <mxCell id="n3" value="Claim submitted with evidence &amp;#183; damage photos, FIR, garage estimate, DL / RC, telematics, dash-cam" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#15306B;strokeColor=#0C1F49;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="860" height="38" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;CLAIMINTEL ORCHESTRATOR&lt;/b&gt; &amp;#160;|&amp;#160; resolves claim kind &amp;#183; runs the eligibility gate before any model call &amp;#183; fans the agents across three dependency phases &amp;#183; applies deterministic guards over the model &amp;#183; streams SSE state and writes result.json incrementally" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#1B3C86;strokeColor=#0C1F49;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="2307" height="46" as="geometry"/></mxCell>
