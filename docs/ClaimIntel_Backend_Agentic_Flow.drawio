        <mxCell id="n174" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C3D1E6;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="451" height="188" as="geometry"/></mxCell>
        <mxCell id="n175" value="&lt;b&gt;Tools and Integrations&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1D4ED8;strokeColor=none;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="41" y="1001" width="449" height="28" as="geometry"/></mxCell>
        <mxCell id="n176" value="&amp;#8226;&amp;#160;Bedrock Converse, ap-south-1, text and vision&lt;br&gt;&amp;#8226;&amp;#160;Amazon Textract, GaniParser account&lt;br&gt;&amp;#8226;&amp;#160;Nominatim geocoding (EU)&lt;br&gt;&amp;#8226;&amp;#160;OpenWeatherMap&lt;br&gt;&amp;#8226;&amp;#160;Serper / Tavily part pricing (US)&lt;br&gt;&amp;#8226;&amp;#160;Groq, permanent-error fallback only, never on a throttle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#243B5E;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="52" y="1036" width="427" height="144" as="geometry"/></mxCell>
        <mxCell id="n177" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C3D1E6;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="503" y="1000" width="451" height="188" as="geometry"/></mxCell>
        <mxCell id="n178" value="&lt;b&gt;Data and Knowledge&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#0F766E;strokeColor=none;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="504" y="1001" width="449" height="28" as="geometry"/></mxCell>
        <mxCell id="n179" value="&amp;#8226;&amp;#160;claims.csv and data/claims/{id}/result.json&lt;br&gt;&amp;#8226;&amp;#160;policies.csv, resolved per claim&lt;br&gt;&amp;#8226;&amp;#160;ChromaDB RAG, local ONNX MiniLM, no API key&lt;br&gt;&amp;#8226;&amp;#160;Historical fraud archive, works on day one&lt;br&gt;&amp;#8226;&amp;#160;OEM price catalogue, written back on every live fetch&lt;br&gt;&amp;#8226;&amp;#160;labour_config and irdai_rules, versioned" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#243B5E;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="515" y="1036" width="427" height="144" as="geometry"/></mxCell>
        <mxCell id="n180" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C3D1E6;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="966" y="1000" width="451" height="188" as="geometry"/></mxCell>
        <mxCell id="n181" value="&lt;b&gt;Security and Governance&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#6D28D9;strokeColor=none;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="967" y="1001" width="449" height="28" as="geometry"/></mxCell>
        <mxCell id="n182" value="&amp;#8226;&amp;#160;PII masked before every LLM call, including inside free text&lt;br&gt;&amp;#8226;&amp;#160;gani_redaction at every egress&lt;br&gt;&amp;#8226;&amp;#160;Fernet encryption at rest&lt;br&gt;&amp;#8226;&amp;#160;Prompt-injection defence on every vision prompt&lt;br&gt;&amp;#8226;&amp;#160;Adjudicator role gate on investigate and decide&lt;br&gt;&amp;#8226;&amp;#160;IRDAI ruleset sha256 stamped into every result" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#243B5E;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="978" y="1036" width="427" height="144" as="geometry"/></mxCell>
        <mxCell id="n183" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C3D1E6;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1429" y="1000" width="451" height="188" as="geometry"/></mxCell>
        <mxCell id="n184" value="&lt;b&gt;State and Reliability&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="1001" width="449" height="28" as="geometry"/></mxCell>
        <mxCell id="n185" value="&amp;#8226;&amp;#160;Per-investigation circuit breakers, re-armed each run&lt;br&gt;&amp;#8226;&amp;#160;Assessment cache, identical evidence replays&lt;br&gt;&amp;#8226;&amp;#160;SSE rejoin for a run already in flight&lt;br&gt;&amp;#8226;&amp;#160;Guards fail closed, an errored agent blocks auto-approval&lt;br&gt;&amp;#8226;&amp;#160;Offline degrades, it never crashes&lt;br&gt;&amp;#8226;&amp;#160;Incremental persistence at every agent boundary" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#243B5E;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1441" y="1036" width="427" height="144" as="geometry"/></mxCell>
        <mxCell id="n186" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C3D1E6;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1892" y="1000" width="451" height="188" as="geometry"/></mxCell>
        <mxCell id="n187" value="&lt;b&gt;Monitoring and Evaluation&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#B91C1C;strokeColor=none;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1893" y="1001" width="449" height="28" as="geometry"/></mxCell>
        <mxCell id="n188" value="&amp;#8226;&amp;#160;token_tracker, cost and usage per call&lt;br&gt;&amp;#8226;&amp;#160;Model preflight at /api/health/models&lt;br&gt;&amp;#8226;&amp;#160;data_sanity, schema, catalogue and archive checks&lt;br&gt;&amp;#8226;&amp;#160;554 regression tests, rates and rules pinned&lt;br&gt;&amp;#8226;&amp;#160;agent_error and agent_skipped surfaced live&lt;br&gt;&amp;#8226;&amp;#160;Reproducibility keyed on evidence, not on sampling" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#243B5E;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1904" y="1036" width="427" height="144" as="geometry"/></mxCell>
        <mxCell id="n189" value="Claim closed &amp;#183; decision, itemised settlement, PDF report and customer letter, full audit trail" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#15306B;strokeColor=#0C1F49;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1208" width="1290" height="44" as="geometry"/></mxCell>
