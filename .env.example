# ── ClaimIntel — API Keys ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys before running docker compose up

# Groq API  (free — https://console.groq.com)
# Powers the text agents (A2 Fraud, A4 Context, A5 Settlement). Vision runs on
# Bedrock — see VISION_PROVIDER below.
GROQ_API_KEY=your_groq_key_here

# ── Groq model IDs ───────────────────────────────────────────────────────────
# CHANGE THESE HERE, NOT IN CODE. Groq retires models on ~30 days' notice and
# has already delisted two that this project used: meta-llama/llama-4-scout-17b
# (vision, Jul 2026) and llama-3.3-70b-versatile (text, Aug 2026). A delisted
# model answers 404 model_not_found and every agent on that path fails.
#
# Check what your key can actually serve before a demo:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" #        https://api.groq.com/openai/v1/models
# or, with the app running:  GET /api/health/models
# or, offline-safe:          python scripts/data_sanity.py   (section 7)
#
# Verified available on a free key 2026-08-19: openai/gpt-oss-120b,
# openai/gpt-oss-20b, qwen/qwen3.6-27b, groq/compound, groq/compound-mini.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Ordered chain, tried ONLY on a 404 (never on a rate limit — falling back on a
# 429 would silently downgrade answer quality for the rest of the day).
GROQ_TEXT_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.6-27b
# Groq vision is the fallback behind Bedrock, not the primary path.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# OpenWeatherMap  (free tier — https://openweathermap.org/api)
# Used by Agent 4 (Context Verification) for live weather at incident location
OPENWEATHERMAP_API_KEY=your_owm_key_here

# ── Live spare-part pricing ─────────────────────────────────────────────────────
# THE ONLY SOURCE OF PART PRICES. Set at least one key. The garage-estimate
# fallback was removed (changelog #39) because pricing a part from the document
# being audited made the "independent" fair value a partial copy of it — so with
# no key here, parts come back unpriced and the fair-value comparison abstains
# rather than quietly reusing the garage's own numbers.
# A price is trusted only when >= 2 independent domains corroborate it.

# Serper.dev  (free — https://serper.dev — 2,500 Google searches)  [preferred]
SERPER_API_KEY=your_serper_key_here

# Tavily      (free — https://tavily.com — 1,000 searches/month)   [alternative]
TAVILY_API_KEY=your_tavily_key_here

# Spare keys. Each provider reads a CHAIN: the key above first, then _2, _3 and
# so on up to _9. Leave them blank until you have one.
#
# Why: one investigation spends 20-50 searches, so a 2,500-search Serper key is
# roughly 50-100 claims and a demo can walk into the wall mid-claim. When a key
# is refused for quota or auth (401/402/403/429/432/433), price_lookup moves to
# the next key in the same chain and retries the same query; anything else
# (timeout, TLS, 5xx) is still treated as the provider being down and falls
# through to the other provider as before. A spent key is never retried again
# in that process, so the dead key costs one failed request, not one per part.
# Restarting the backend re-arms every key, which is what you want for a quota
# that refills daily.
#
# The rotation prints a line per event, e.g.
#   [pricing] serper key ...9f2c spent (HTTP 403)
# so an exhausted key is visible in the log instead of quietly turning into
# unpriced parts and abstaining fair-value bands.
SERPER_API_KEY_2=
TAVILY_API_KEY_2=

# Share (0-1) of a claim's damaged parts that must carry an independent live-web
# price before the fair-value bands and the inflation cap may reach a verdict.
# Below it, settlement_calc abstains, FC-17/FC-23 emit "na", and depreciation
# falls back to the blanket parts fraction (per-part depreciation over unpriced
# ₹0 parts would under-deduct and overpay).
PRICING_MIN_COVERAGE=0.70

# Labour rates/hours/complexity/thresholds. Rule-based estimates, NOT OEM
# standard times — see services/labour_providers.py for the interface a licensed
# OEM/estimating feed would implement. Point this at an insurer-supplied file to
# replace the defaults wholesale.
LABOUR_CONFIG_PATH=

# ── PII encryption at rest ───────────────────────────────────────────────────────
# Encrypts claimant name + phone in claims.csv. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without a key, the app still runs but PII is stored in plaintext.
ENCRYPTION_KEY=

# ── AWS Bedrock (optional) ───────────────────────────────────────────────────────
# Enables Bedrock vision-model bounding-box grounding for damage photos (Agent 1) —
# see DAMAGE_VALIDATION_ARCHITECTURE.md §E. Without these set, the app falls back to
# the existing Groq-provided boxes unchanged; this is an enhancement, not a
# requirement. Needs an IAM user with Bedrock InvokeModel permission, and the chosen
# model's access GRANTED in the Bedrock console for AWS_REGION (Bedrock gates each
# model behind a separate per-region access request — having a key alone is not
# enough).
#
# Two verified options (checked against AWS's live regional-availability docs,
# 2026-07-16 — do not trust older assumptions in this repo's docs over this):
#   1. Default below — Amazon Nova Lite, us-east-1. Cheapest, broadest support, but
#      Nova has NO India-region presence at all (not even cross-region routing) —
#      picking a different AWS_REGION here won't get you India residency with Nova.
#   2. India-region (Mumbai) option — swap to:
#        AWS_REGION=ap-south-1
#        BEDROCK_GROUNDING_MODEL=qwen.qwen3-vl-235b-a22b
#      Qwen3-VL-235B-A22B is genuinely IN-REGION in ap-south-1 (Mumbai) per AWS's own
#      model card — the only vision-capable Bedrock model confirmed to be. It's the
#      only size Qwen ships on Bedrock (no smaller/cheaper tier like Nova's "Lite"),
#      so check the Bedrock console's pricing tab against your free-tier credits
#      before relying on it. Uses the exact same code path in grounding_client.py —
#      this is a config-only swap, no code change needed.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
BEDROCK_GROUNDING_MODEL=amazon.nova-lite-v1:0

# ── Vision provider ─────────────────────────────────────────────────────────────
# Runs EVERY image-bearing call: damage assessment, incident reconstruction,
# document authenticity, bbox grounding. Groq is TEXT-ONLY for this project.
#
# Why: Groq retired its previous vision model mid-project on 30 days' notice, and
# the one it still serves is capped at 8,000 tokens/minute on the free tier — a
# single 1424x900 claim photo plus the damage prompt produced an 11,430-token
# request and a 413. The Bedrock model is ~9x larger and keeps photos in-region.
# Set to "groq" only if AWS is unavailable; expect rate-limit failures.
VISION_PROVIDER=bedrock

# Only vision model verified available in ap-south-1 on our account — Nova (any
# size), Pixtral and Llama-3.2-Vision all fail there.
BEDROCK_VISION_MODEL=qwen.qwen3-vl-235b-a22b

# ── Text provider ───────────────────────────────────────────────────────────────
# Runs every text-only call: A2 (fraud), A5 (settlement), document field
# extraction, and ask_json's JSON-repair pass — which fires on behalf of the
# VISION agents too, so this reaches A1/A3 indirectly.
#
# Why: openai.gpt-oss-120b-1:0 on Bedrock is the SAME open weights Groq serves as
# openai/gpt-oss-120b, so this is a relocation rather than a model change. Claim
# text stops leaving India, and the Groq free tier stops being the ceiling on
# daily claim volume. It is ON_DEMAND in ap-south-1, so no inference profile is
# needed — a bare model ID works.
#
# Cost: $0.18/$0.71 per 1M in/out vs Groq's $0.15/$0.60 — ~19% more on the text
# slice, +$0.70 per 1,000 claims end to end.
#
# Groq remains the FALLBACK, and is used ONLY when Bedrock reports a permanent
# error (bad/absent/unentitled model ID). A throttle or 5xx deliberately does NOT
# fall back: quietly retrying in the US would undo the residency this exists for.
# Set to "groq" to fall back deliberately — that is the whole rollback.
TEXT_PROVIDER=bedrock
BEDROCK_TEXT_MODEL=openai.gpt-oss-120b-1:0

# ── GaniParser document path (optional) ─────────────────────────────────────────
# services/gani_parser.py runs Ganit's GaniParser pipeline over the four uploaded
# PII documents (garage estimate, FIR, driving licence, RC): Textract OCR, then
# Bedrock field extraction, then PII masking — instead of sending the document
# image to Groq. Damage photos are NOT in this path.
#
# Used for the Textract OCR call ONLY — Textract is entitled on GaniParser's AWS
# account and not on ours. Everything after OCR (field extraction, authenticity)
# runs on the AWS_* credentials above, so this project puts no inference load on
# an account it does not own. Leave blank to fall back to AWS_* for OCR too,
# which is correct for a single-account deployment.
GANI_AWS_ACCESS_KEY_ID=
GANI_AWS_SECRET_ACCESS_KEY=
GANI_AWS_REGION=ap-south-1

# ── Document text extraction (services/ocr.py) ──────────────────────────────────
# No configuration. A born-digital PDF is read from its own text layer (free,
# exact, never leaves the machine); only real images and scans reach Textract on
# the GANI_AWS_* credentials above. In practice the estimate, FIR and RC are
# digital PDFs and never touch Textract at all — a photographed licence and the
# handwritten claim form do. Textract pages are logged per claim and shown in
# Analytics -> FinOps.

# Who runs the two INFERENCE steps of the document path (field extraction from
# the OCR text, and the FC-28 authenticity check on the document image). OCR
# itself is always Textract on GANI_AWS_*.
#
# Defaults to "bedrock" alongside TEXT_PROVIDER above, so the OCR text — which
# holds the DL number, DOB and address Textract just read — stays in-region.
# ROLLBACK: set to "groq".
DOC_INFERENCE_PROVIDER=bedrock

# Model that turns the OCR text into structured fields, on AWS_*. A TEXT model.
# Blank reuses BEDROCK_TEXT_MODEL, which is the same weights the Groq path used
# for this call — keeping the provider move a move rather than a model swap.
# Do NOT set this to qwen.qwen3-235b-a22b-2507-v1:0 without meaning to: it was
# the old default, and it costs 73% more on this slot for a different model.
#
# GaniParser's own default is Claude 3 Sonnet, but Bedrock returns
# ResourceNotFoundException for it until the Anthropic "use case details" form is
# submitted in the console. After submitting that form you could set:
#   BEDROCK_DOC_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_DOC_MODEL=

# Vision model for the document-authenticity check feeding fraud check FC-28, on
# AWS_*. Must be VISION-capable — it is shown the document image, because forgery
# signals (fonts, stamp edges, template layout) do not survive OCR. Blank reuses
# BEDROCK_GROUNDING_MODEL.
BEDROCK_DOC_VISION_MODEL=

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Adds one button per showcase case to the New Claim page: a click fills that
# case's fields and attaches its documents from test/, so a demo can be filed
# without knowing which phone number opens which policy. Fills only — it never
# submits.
#
# SET THIS TO false IN ANY REAL DEPLOYMENT. It serves files from test/ over HTTP
# on an unauthenticated route; with it off, both the panel and those routes
# disappear entirely.
#
# The button data comes from data/config/demo_cases.json, written by
# `python scripts/generate_test_cases.py` — run that first, or the panel stays
# hidden. Note the damage photos are gitignored (test/**/*.jpg|png|mp4), so on a
# fresh clone the buttons attach the PDFs, name the missing photos, and leave
# those for you to add by hand.
DEMO_MODE=true
